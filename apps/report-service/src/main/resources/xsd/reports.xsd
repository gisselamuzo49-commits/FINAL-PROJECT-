<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://uce.com/report_service/ws"
           targetNamespace="http://uce.com/report_service/ws"
           elementFormDefault="qualified">

    <xs:element name="GetReporteEstudianteRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="estudianteId" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetReporteEstudianteResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="estudianteId" type="xs:string"/>
                <xs:element name="totalHorasValidadas" type="xs:decimal"/>
                <xs:element name="totalHorasPendientes" type="xs:decimal"/>
                <xs:element name="totalDocumentos" type="xs:int"/>
                <xs:element name="ultimaActualizacion" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
