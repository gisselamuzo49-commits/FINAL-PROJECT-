                  ,"index": 118
                }
              }
                ,"logicalLocations": [
                    {
                    "fullyQualifiedName": "pkg:maven\/io.vertx\/vertx-core@4.5.1"
                    }
                ]
              
            }
          ]
          }, {
          "ruleId": "CVE-2024-8391",
          "level": "warning",
          "message": {
            "text": "CVE-2024-8391 - In Eclipse Vert.x version 4.3.0 to 4.5.9, the gRPC server does not limit the maximum length of message payload (Maven GAV: io.vertx:vertx-grpc-server and io.vertx:vertx-grpc-client).\u00A0\n\n\n\n\nThis is fixed in the 4.5.10 version.\u00A0\n\n\n\n\nNote this does not affect the Vert.x gRPC server based grpc-java and Netty libraries (Maven GAV: io.vertx:vertx-grpc)"
