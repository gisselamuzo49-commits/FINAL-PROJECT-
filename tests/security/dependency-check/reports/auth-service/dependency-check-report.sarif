              "shortDescription": {
                 "text": "high severity - CVE-2026-41838 Use of Insufficiently Random Values vulnerability in auth-service-0.0.1-SNAPSHOT.jar: spring-core-7.0.7.jar"
              },
              "fullDescription": {
